าวปั้น ใช้ร่วมกัน 3 จุด (ดู hungerWidget ใน ui.js) */\n.hunger-line{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:4px}\n.hunger-line small{white-space:nowrap}\n.hunger-line small[data-rest-why],.hunger-line small[data-rest-team]{white-space:normal;flex-basis:100%;line-height:1.6}\n.hunger-line .rest-name{flex-basis:100%;font-size:13px}\n\n/* ---------- เลย์เอาต์หลัก ----------\n   ฉากกินเต็มความกว้าง แผงควบคุมกับบันทึกอยู่ใต้ฉาก\n   (เดิมแผงอยู่ข้าง ๆ ทำให้ฉากเหลือความกว้างไม่ถึงสองในสาม) */\n.below{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:var(--space-3);align-items:start}\n@media(max-width:900px){.below{grid-template-columns:1fr}}\n/* ---------- ข้อ D ชุด 15 — .stage เต็มพื้นที่ที่เหลือของจอ (ไม่มีกรอบ/แถบข้อความรอบนอกแบบเดิม)\n   .scene-box ล็อกอัตราส่วน 1527:704 อยู่ข้างใน จัดกลางด้วย flex — เกิด letterbox บน/ล่างหรือซ้าย/ขวา\n   แทนการครอป (ยังไม่ทำ D.1 ส่วนภาพ/พิกัดใหม่รอบนี้ — ดูรายงาน Toby ว่าทำไม) */\n.stage{flex:1;min-height:0;position:relative;overflow:hidden;\n  background:#0b0508;display:flex;align-items:center;justify-content:center}\n/* ขนาดจริง (px) ตั้งโดย fitSceneBox() ใน ui.js ผ่าน ResizeObserver — CSS aspect-ratio ล้วนๆ\n   ผสมกับ flex-centering มีเคสมุมขอบที่ clamp ผิดแกน (max-width ตัดแล้ว height ไม่รีเคลียร์ตาม)\n   ใช้ JS วัดจริงชัวร์กว่า กัน #ov/canvas เพี้ยนตำแหน่งซึ่งกระทบการคลิกทั้งเกม */\n.scene-box{position:relative}\n.scene-box canvas{position:absolute;inset:0;width:100%;height:100%}\n\n/* ป้ายบอกว่าวาระหยุดเดินอยู่ — ของเดิมรู้ได้จากตัวหนังสือบนปุ่มใต้ฉากเท่านั้น\n   ผู้เล่นเลยนั่งรอทัณฑ์ที่ค้าง 0% อยู่นานโดยไม่รู้ว่าเกมพักอยู่ (เจ้าของเจอ 8 ก.ย. 2569) */\n.stage.resting::after{content:"⏸ พักอยู่ — กด \\201Cเปิดศาล\\201D ให้เวลาเดินต่อ";\n  position:absolute;left:50%;bottom:calc(var(--space-4) + 64px);transform:translateX(-50%);z-index:8;\n  background:rgba(12,6,9,.9);border:1px solid var(--gold);color:var(--gold);\n  border-radius:99px;padding:7px 16px;font-size:var(--text-sm);white-space:nowrap;\n  backdrop-filter:blur(3px);box-shadow:0 4px 18px rgba(0,0,0,.6);\n  animation:restpulse 2.4s ease-in-out infinite;pointer-events:none}\n@keyframes restpulse{0%,100%{opacity:.72}50%{opacity:1}}\n@media(max-width:820px){.stage.resting::after{font-size:var(--text-xs);padding:5px 11px}}\n\n/* ---------- ชั้นซ้อนบนฉาก: บับเบิลคำพูด + เมนูพลัง ----------\n   ทุกตำแหน่งคิดเป็น % ของภาพฉาก จึงเลื่อนตามขนาดจอเองโดยไม่ต้องคำนวณใหม่ */\n#ov{position:absolute;inset:0;pointer-events:none;font-size:var(--text-xs)}\n#ov>*{position:absolute}\n\n/* หมุดเหนือหัวตัวละคร — เอาเมาส์ไปชี้ถึงจะกางบับเบิลออกมา\n   (บับเบิลกางค้างไว้ตลอดบังฉากจนมองไม่เห็นแผนที่) */\n.mark{transform:translate(-50%,-100%);pointer-events:auto;cursor:help}\n.mark .pin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;\n  font-size:14px;background:rgba(24,11,17,.92);border:1.5px solid var(--gold);\n  box-shadow:0 2px 8px rgba(0,0,0,.6);animation:pin 2.2s ease-in-out infinite}\n.mark.soul .pin{border-color:#7fb2e0} .mark.boss .pin{border-color:var(--primary)}\n@keyframes pin{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}\n.mark .bub{display:none;position:absolute;bottom:34px;left:50%;transform:translateX(-50%)}\n.mark.aL .bub{left:-8px;transform:none}\n.mark.aR .bub{left:auto;right:-8px;transform:none}\n.mark:hover .bub,.mark.show .bub{display:block}\n.mark:hover{z-index:9}\n\n.bub{width:min(32vw,340px);background:rgba(24,11,17,.96);\n  border:1px solid var(--border);border-radius:var(--radius-md);padding:8px 11px;\n  line-height:1.6;box-shadow:var(--shadow-lg)}\n.bub:after{content:'';position:absolute;bottom:-8px;left:50%;margin-left:-8px;\n  border:8px solid transparent;border-top-color:rgba(24,11,17,.96);border-bottom:0}\n.mark.aL .bub:after{left:20px;margin:0} .mark.aR .bub:after{left:auto;right:20px;margin:0}\n.bub .who{color:var(--gold);font-weight:600;display:block;margin-bottom:3px}\n.bub.soul{background:rgba(18,26,38,.95);border-color:#33455c}\n.bub.soul:after{border-top-color:rgba(18,26,38,.95)}\n.bub.boss{background:rgba(38,12,10,.96);border-color:var(--primary);width:min(34vw,400px)}\n.bub.boss:after{border-top-color:rgba(38,12,10,.96)}\n.bub .line{color:var(--muted-foreground);padding:1px 0}\n.bub .line.truth{color:var(--gold)} .bub .line.confess{color:var(--warning)}\n.bub .line.false{color:var(--destructive)}\n\n.mark.speech-side .bub{bottom:-8px;left:38px;transform:none}\n.mark.speech-side .bub:after{left:-8px;bottom:12px;margin:0;border:8px solid transparent;border-right-color:rgba(24,11,17,.96);border-left:0;border-top-color:transparent}\n.mark.speech-side.aR .bub{left:auto;right:38px;transform:none}\n.mark.speech-side.aR .bub:after{left:auto;right:-8px;border-right:0;border-left:8px solid rgba(24,11,17,.96)}\n.mark.speech-side.soul .bub{font-size:10px;line-height:1.45;width:min(26vw,280px)}\n#ov .repairfab[data-target="nira"]{z-index:10;white-space:nowrap}\n/* ---------- แถบบัญชาการเหนือฉาก ----------\n   เดิมแผงนี้ลอยทับกลางฉากจนมองแผนที่ไม่เห็น ย้ายมาอยู่เหนือฉากเป็นแถบเต็มความกว้าง */\n/* ---------- แถบโค้ช: สอนทีละเรื่อง ----------\n   เดิมมีแต่โมดัล "วิธีเล่น" ที่เทสิบสามข้อพร้อมกัน เจ้าของบอกว่าดูยากไป (7 ก.ย. 2569) */\n/* ย้ายมาอยู่ล่างสุดของหน้า 8 ก.ย. 2569 — เดิมอยู่ใต้หัวเรื่อง\n   ทุกครั้งที่มีบทใหม่ มันดันแถบบัญชาการกับฉากเลื่อนลงไปทั้งแผง จนคลิกผิดที่ */\n.coach{background:linear-gradient(90deg,var(--accent),var(--card));\n  border:1px solid var(--gold);border-left-width:4px;border-radius:var(--radius);\n  padding:var(--space-3) var(--space-4);display:flex;gap:var(--space-3);align-items:flex-start;\n  margin-top:auto}\n.coach .txt{min-width:0;flex:1}\n.coach b{color:var(--gold);font-family:var(--font-display);font-size:1.05rem;display:block;margin-bottom:2px}\n.coach p{margin:0;font-size:var(--text-sm);line-height:var(--leading-body)}\n.coach .tip{margin-top:6px;font-size:var(--text-xs);color:var(--accent-foreground)}\n.coach .step{font-size:var(--text-xs);color:var(--muted-foreground);white-space:nowrap}\n.coach button{flex-shrink:0}\n\n/* ชิปทรัพยากรกดได้ทุกอัน — กดแล้วบอกว่าแถบนั้นมีไว้ทำอะไร หมดแล้วเกิดอะไร */\n.chip.tap{cursor:pointer;border-color:var(-`... 171977 more characters,
