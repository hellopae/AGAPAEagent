%{opacity:1}}\n@media(max-width:820px){.stage.resting::after{font-size:var(--text-xs);padding:5px 11px}}\n\n/* ---------- ชั้นซ้อนบนฉาก: บับเบิลคำพูด + เมนูพลัง ----------\n   ทุกตำแหน่งคิดเป็น % ของภาพฉาก จึงเลื่อนตามขนาดจอเองโดยไม่ต้องคำนวณใหม่ */\n#ov{position:absolute;inset:0;pointer-events:none;font-size:var(--text-xs)}\n#ov>*{position:absolute}\n\n/* หมุดเหนือหัวตัวละคร — เอาเมาส์ไปชี้ถึงจะกางบับเบิลออกมา\n   (บับเบิลกางค้างไว้ตลอดบังฉากจนมองไม่เห็นแผนที่) */\n.mark{transform:translate(-50%,-100%);pointer-events:auto;cursor:help}\n.mark .pin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;\n  font-size:14px;background:rgba(24,11,17,.92);border:1.5px solid var(--gold);\n  box-shadow:0 2px 8px rgba(0,0,0,.6);animation:pin 2.2s ease-in-out infinite}\n.mark.soul .pin{border-color:#7fb2e0} .mark.boss .pin{border-color:var(--primary)}\n@keyframes pin{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}\n.mark .bub{display:none;position:absolute;bottom:34px;left:50%;transform:translateX(-50%)}\n.mark.aL .bub{left:-8px;transform:none}\n.mark.aR .bub{left:auto;right:-8px;transform:none}\n.mark:hover .bub,.mark.show .bub{display:block}\n.mark:hover{z-index:9}\n\n.bub{width:min(32vw,340px);background:rgba(24,11,17,.96);\n  border:1px solid var(--border);border-radius:var(--radius-md);padding:8px 11px;\n  line-height:1.6;box-shadow:var(--shadow-lg)}\n.bub:after{content:'';position:absolute;bottom:-8px;left:50%;margin-left:-8px;\n  border:8px solid transparent;border-top-color:rgba(24,11,17,.96);border-bottom:0}\n.mark.aL .bub:after{left:20px;margin:0} .mark.aR .bub:after{left:auto;right:20px;margin:0}\n.bub .who{color:var(--gold);font-weight:600;display:block;margin-bottom:3px}\n.bub.soul{background:rgba(18,26,38,.95);border-color:#33455c}\n.bub.soul:after{border-top-color:rgba(18,26,38,.95)}\n.bub.boss{background:rgba(38,12,10,.96);border-color:var(--primary);width:min(34vw,400px)}\n.bub.boss:after{border-top-color:rgba(38,12,10,.96)}