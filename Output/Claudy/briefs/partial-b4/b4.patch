@@ -0,0 +1,70 @@
+// B4 progression boundary: B3 can consume trainingLevel/trainingDamage without
+// changing session accounting. Actor identity comes from the B1 roster.
+export const HERO_TRAINING_ID = 'global:yama';
+export const TRAINING_EXP = Object.freeze([0, 60, 150, 270, 420]);
+export const TRAINING_CAPS = Object.freeze({ th:2, asia:3, west:4, cyberhell:5 });
+export const TRAINING_STATIONS = Object.freeze({ dab:['yama'], lan:['taan','guard'], lokan:['guard'], krata:['plerng'] });
+const integer = n => Number.isFinite(n) ? Math.max(0, Math.floor(n)) : 0;
+export const scoreExp = score => Number.isFinite(score) && score >= 60 && score <= 100 ? score >= 95 ? 40 : score >= 80 ? 30 : 20 : 0;
+export function trainingLevel(state, id) {
+  const exp = integer(state?.actors?.[id]?.exp);
+  return TRAINING_EXP.reduce((lv, threshold, i) => exp >= threshold ? i + 1 : lv, 1);
+}
+export function restoreTraining(saved) {
+  const state = { version:1, sequence:integer(saved?.sequence), actors:{}, activeSession:null };
+  for (const [id, a] of Object.entries(saved?.actors || {})) {
+    const exp = Math.min(420, integer(a.exp));
+    state.actors[id] = { exp, level:trainingLevel({ actors:{ [id]:{ exp } } }, id),
+      readyAtTick:integer(a.readyAtTick), window:integer(a.window), attempts:Math.min(2, integer(a.attempts)) };
+  }
+  // Interrupted sessions never earn EXP; already consumed attempts/CD survive.
+  return state;
+}
+export function trainingTargets(g, station) {
+  return (TRAINING_STATIONS[station] || []).flatMap(kind => {
+    if (kind === 'yama') return [{ id:HERO_TRAINING_ID, kind, homeZone:'global', name:'ยมบาทน้อย / Young Yama' }];
+    return Object.values(g.roster || {}).filter(a => a.kind === kind && a.homeZone === g.zone);
+  });
+}
+export function trainingWhy(g, station, actorId) {
+  const st = g.stations.find(s => s.def.k === station);
+  if (!st || st.build) return 'สถานียังไม่พร้อม / Station unavailable';
+  if (g.paused || g.over) return 'เกมหยุดอยู่ / Game paused';
+  if (g.training?.activeSession) return 'กำลังฝึก / Training in progress';
+  if (!trainingTargets(g, station).some(a => a.id === actorId)) return 'เลือกผู้ฝึกในโซนนี้ / Select a trainee in this zone';
+  const a = g.training?.actors?.[actorId];
+  if (trainingLevel(g.training, actorId) >= (TRAINING_CAPS[g.zone] || 2)) return 'ถึงเพดานโซน / Zone level cap reached';
+  if (g.tick < (a?.readyAtTick || 0)) return `รอ ${a.readyAtTick - g.tick} วาระ / ticks`;
+  if (a?.window === Math.floor(g.tick / 100) && a.attempts >= 2) return 'ครบ 2 ครั้งในช่วง 100 วาระ / Attempt limit';
+  return '';
+}
+export function beginTraining(g, station, actorId) {
+  if (trainingWhy(g, station, actorId)) return null;
+  g.training ||= restoreTraining();
+  const state = g.training, old = state.actors[actorId] || { exp:0, level:1, readyAtTick:0, window:0, attempts:0 };
+  const window = Math.floor(g.tick / 100);
+  state.actors[actorId] = { ...old, window, attempts:(old.window === window ? old.attempts : 0) + 1, readyAtTick:g.tick + 30 };
+  const session = { id:`training:${++state.sequence}`, actorId, zone:g.zone, station, seed:state.sequence * 2654435761 >>> 0 };
+  state.activeSession = session;
+  return { ...session };
+}
+export function finishTraining(g, result) {
+  const state = g.training, session = state?.activeSession;
+  if (!session || result.sessionId !== session.id) return null;
+  // Consume first: stale callbacks and duplicate results cannot award anything.
+  state.activeSession = null;
+  const a = state.actors[session.actorId], before = trainingLevel(state, session.actorId);
+  const cap = TRAINING_EXP[(TRAINING_CAPS[session.zone] || 2) - 1];
+  const exp = result.completed === true && g.zone === session.zone ? scoreExp(result.score) : 0;
+  const gained = Math.max(0, Math.min(cap, a.exp + exp) - a.exp);
+  a.exp += gained; a.level = trainingLevel(state, session.actorId);
+  return { actorId:session.actorId, score:result.score, exp:gained, before, level:a.level,
+    multiplierBefore:1 + (before - 1) * (session.actorId === HERO_TRAINING_ID ? .03 : .06),
+    multiplierAfter:1 + (a.level - 1) * (session.actorId === HERO_TRAINING_ID ? .03 : .06) };
+}
+export function trainingDamage(g, id, action, base) {
+  const kind = id === HERO_TRAINING_ID ? 'yama' : g.roster?.[id]?.kind;
+  if (kind === 'yama' && action === 'atk') return Math.round(base * (1 + .03 * (trainingLevel(g.training, id) - 1)));
+  if (['taan','guard','plerng'].includes(kind) && action === 'assist') return Math.round(base * (1 + .06 * (trainingLevel(g.training, id) - 1)));
+  return base;
+}
